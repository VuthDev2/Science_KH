# ==============================================================================
# ScienceKH — Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Supabase Public API Configuration
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"
SUPABASE_URL="https://your_project.supabase.co"

# Frontend Vite Variables (Exposed to Browser)
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_URL="https://your_project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"
VITE_API_URL="http://localhost:5001"

# Backend Server Configuration
PORT=5001
NODE_ENV="development"
CLIENT_URL="http://localhost:8080"
JWT_SECRET="your_cryptographically_secure_random_jwt_secret"

# Nodemailer / SMTP Configuration (Gmail with App Password, Resend, or SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
EMAIL_FROM="ScienceKH <your_email@gmail.com>"

# Supabase Service Role Key (OPTIONAL: Server-only, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# Redis Cache & Distributed Rate Limiting (Optional: falls back to in-memory cache if omitted)
# REDIS_URL="rediss://default:your_password@your-upstash-endpoint.upstash.io:6379"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
# REDIS_PASSWORD="your_redis_password"
REDIS_DEFAULT_TTL=3600
REDIS_ENABLED="true"

# Telegram Real-Time Security Alerting
# 1. Create a bot with @BotFather on Telegram (get the bot token)
# 2. Get your Chat ID from @userinfobot or invite bot to a group/channel
# 3. Fill in the values below:
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_SECURITY_CHAT_ID="123456789"
TELEGRAM_ALERTS_ENABLED="true"
TELEGRAM_ALERT_RATE_LIMIT_SECONDS=30


